<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{dd-MM-yyyy HH:mm:ss.SSS} %magenta([%thread]) %blue(%-5level) %logger{36}.%M - %msg%n
            </pattern>
        </encoder>
    </appender>
    <logger name="ru.develonica" level="debug" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>
</configuration>